{
	"name": "dg/fio-mcp",
	"description": "🏦 Fio MCP: an MCP server for the Fio banka API. Ask your AI assistant who paid you or whether an invoice was settled, and let it prepare payments that you then authorize in the bank.",
	"keywords": ["fio", "fio banka", "bank api", "banking", "payments", "mcp", "model context protocol", "ai"],
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"license": "MIT",
	"require": {
		"php": ">=8.2",
		"ext-curl": "*",
		"ext-mbstring": "*",
		"ext-simplexml": "*",
		"ext-xmlwriter": "*",
		"mcp/sdk": "^0.9",
		"symfony/finder": "^7.0 || ^8.0"
	},
	"require-dev": {
		"nette/tester": "^2.5",
		"phpstan/phpstan": "^2.2",
		"phpstan/extension-installer": "^1.4",
		"nette/phpstan-rules": "^1.0"
	},
	"autoload": {
		"classmap": ["src/"]
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s"
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true,
			"php-http/discovery": true
		}
	}
}
